# Never prefix this value with NEXT_PUBLIC_. Keep the real value only in .env.local.
SPORTRADAR_API_KEY=
SPORTRADAR_USE_FIXTURES=true
SPORTRADAR_NBA_BASE_URL=https://api.sportradar.com
SPORTRADAR_NBA_ACCESS_LEVEL=trial
SPORTRADAR_EDITORIAL_BASE_URL=https://api.sportradar.com
SPORTRADAR_EDITORIAL_ACCESS_LEVEL=t
SPORTRADAR_EDITORIAL_PROVIDER=ap
